{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx playwright *)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make test *)",
      "Bash(make test-backend)",
      "Bash(make test-frontend)",
      "Bash(make e2e)",
      "Bash(make logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(python3 scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(npm test)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(uv sync)",
      "Bash(make test)",
      "Bash(git branch --show-current)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(docker compose exec db createdb *)",
      "Bash(docker compose exec db psql *)",
      "Bash(docker compose exec -T db psql *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx --no *)",
      "Bash(git add -p *)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase origin/main --exec *)",
      "Bash(GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash origin/main)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(docker compose down -v *)",
      "Bash(npm install *)",
      "Bash(uv add *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(gh *)",
      "Bash(docker compose exec db dropdb *)",
      "Bash(git rebase -i *)",
      "Bash(git rebase --onto *)",
      "Bash(git commit *)",
      "Bash(git commit --fixup *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.sh\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
