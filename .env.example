# Local configuration. Copy to .env (git-ignored) and change only what you need; every value
# below is the default, so an empty or missing .env works too. The process environment always
# wins over this file. No real secrets here: these are local development credentials.

# --- Docker Compose (compose.yaml interpolates these; it reads this .env by itself) -----------
# Users and passwords are copied as is into the services' DATABASE_URL and RABBITMQ_URL: use only
# URL-safe characters (letters, digits, - . _ ~).
DI1_DB_USER=di1
DI1_DB_PASSWORD=di1
DI1_DB_NAME=di1
DI1_RABBITMQ_USER=di1
DI1_RABBITMQ_PASSWORD=di1
DI1_RABBITMQ_DELIVERY_LIMIT=5
DI1_LOG_LEVEL=INFO
# Host ports (127.0.0.1 only).
DI1_API_PORT=8000
DI1_WEB_PORT=8080
DI1_RABBITMQ_MANAGEMENT_PORT=15672
# 1 loads the demo data on a fresh stack (scripts/seed_demo.py); 0 starts with an empty ledger.
DI1_DEMO=1

# --- Backend outside Docker (uv run in backend/: API, alembic, workers) -----------------------
# di1.platform.config reads this file (then backend/.env). Compose ignores these: its services set
# their own. Compose does not publish PostgreSQL or AMQP to the host, so point these at a server
# of your own. Uncomment to use.
# DATABASE_URL=postgresql+psycopg://di1:di1@127.0.0.1:5432/di1
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_ECHO=false
# LOG_LEVEL=INFO
# Broker: only the outbox relay and the worker read these.
# RABBITMQ_URL=amqp://di1:di1@127.0.0.1:5672/
# RABBITMQ_PREFETCH_COUNT=1
# RABBITMQ_DELIVERY_LIMIT=5
# RABBITMQ_RETRY_BASE_DELAY_SECONDS=1.0
# RABBITMQ_RETRY_MAX_DELAY_SECONDS=30.0
# RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10.0
# OUTBOX_RELAY_BATCH_SIZE=100
# OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1.0
# OUTBOX_RELAY_RETRY_BASE_DELAY_SECONDS=1.0
# OUTBOX_RELAY_RETRY_MAX_DELAY_SECONDS=60.0
# INBOX_RETENTION_DAYS=7
# INBOX_RETENTION_INTERVAL_SECONDS=3600
# Worker heartbeat (unset: no heartbeat file).
# HEARTBEAT_FILE=/tmp/di1-worker.heartbeat
# HEARTBEAT_INTERVAL_SECONDS=5.0
# HEARTBEAT_MAX_AGE_SECONDS=30.0
